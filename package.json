{
  "name": "kleaner-services",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "description": "Kleaner services hub for services.kleaner.my",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/gen-owner-confirm.mjs",
    "preview": "astro preview",
