    "lighthouse": "node scripts/lighthouse.mjs",
    "preview:bundle": "npm run build && node scripts/gen-preview.mjs",
    "logo": "node scripts/gen-logo.mjs"
  },
  "dependencies": {
    "astro": "^7.3.3"
  },
  "devDependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/reddit-sans": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "lighthouse": "^13.5.0",
    "playwright": "^1.56.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3"
  }
}
