---
import Icon from './Icon.astro'
import ConfirmNote from './ConfirmNote.astro'
import { SERVICES } from '../data/services'
import type { ServicesCopy } from '../data/copy/services.en'

// Renders from src/data/services.ts and nothing else. There is no card in this
// file, only the shape of one.
//
// The whole card is the link, so the tap target is the card rather than the
// button inside it. That means no real <button> here: the Book now control is
// a styled span, because an interactive element nested inside an anchor is
// invalid and breaks keyboard order.
interface Props {
  copy: ServicesCopy
}
const { copy } = Astro.props as Props
const { grid } = copy
---

<ul class="grid grid-cols-2 gap-4 md:grid-cols-3 md:gap-6">
  {
    SERVICES.map((service) => (
      <li class="flex flex-col" data-reveal>
        <a
          href={service.bookingUrl}
          class="lift flex h-full flex-col rounded-card border border-brand-line bg-white p-3.5 shadow-soft md:p-6"
          data-cta="book"
          data-service={service.slug}
          data-service-card
          rel="noopener"
        >
          {/* Icon and badge share a row. Absolutely positioning the badge put
              it on top of the icon once the card narrowed to half a phone. */}
          <span class="flex items-center justify-between gap-2">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-brand-circle text-brand">
              <Icon name={service.icon} size={26} />
            </span>
            {service.badge && (
              <span class="whitespace-nowrap rounded-full bg-brand-circle px-2 py-1 text-[10px] font-black uppercase tracking-wide text-brand-ink md:px-2.5 md:text-[12px]">
                {service.badge}
              </span>
            )}
          </span>

          <h2 class="mt-4 text-[17px] font-black leading-tight md:text-[20px]">
            {service.name}
          </h2>

          <p class="mt-2 text-[14px] leading-relaxed md:text-[16px]">{service.promise}</p>

          <ul class="mt-3 flex flex-col gap-1.5">
            {service.bullets.map((bullet) => (
              <li class="flex gap-2 text-[13px] leading-snug text-navy md:text-[15px]">
                <Icon name="check" size={15} class="mt-0.5 shrink-0 text-brand" />
                <span>{bullet}</span>
              </li>
            ))}
          </ul>

          <p class="mt-4 grow text-[16px] font-black text-brand-ink md:text-[18px]">
            {service.price}
          </p>

          {/* The note goes above the button, not below it. Below, a card that
              has one pushed its button up and the row stopped lining up. */}
          {service.isFallbackUrl && (
            <span class="mt-2 block text-[12px] leading-snug md:text-[13px]">
              {grid.fallbackNote}
            </span>
          )}

          <span class="press mt-4 inline-flex items-center justify-center gap-2 rounded-full bg-brand-dark px-4 py-3 text-[15px] font-bold leading-none text-white md:text-[17px]">
            {grid.book}
            <Icon name="arrow" size={18} />
          </span>
        </a>

        {service.confirm && <ConfirmNote compact class="mt-2">{service.confirm}</ConfirmNote>}
      </li>
    ))
  }
</ul>
