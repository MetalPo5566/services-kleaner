  mattress: '<rect x="2.5" y="6.5" width="19" height="11" rx="3.5"/><path d="M7 10.5v3M12 10.5v3M17 10.5v3"/>',
  carpet: '<rect x="3" y="5.5" width="18" height="12.5" rx="1.8"/><rect x="6.5" y="9" width="11" height="5.5" rx="1"/><path d="M6 18v2M10 18v2M14 18v2M18 18v2"/>',
  curtain: '<path d="M3 4h18"/><path d="M6.5 4v16c2.6 0 4.2-2.6 4.2-8S9.1 4 6.5 4Z"/><path d="M17.5 4v16c-2.6 0-4.2-2.6-4.2-8s1.6-8 4.2-8Z"/>',
  mite: '<ellipse cx="12" cy="13.5" rx="5" ry="4"/><path d="M7.4 11 4.5 8M16.6 11l2.9-3M7.4 16l-2.9 3M16.6 16l2.9 3M12 9.5v-3M10.2 5.2 12 4l1.8 1.2"/>',
  droplet: '<path d="M12 3.2c0 0 6.2 6.6 6.2 10.3a6.2 6.2 0 0 1-12.4 0C5.8 9.8 12 3.2 12 3.2Z"/>',
  shield: '<path d="M12 3 5 6v5.6c0 4.3 2.9 7.6 7 9.4 4.1-1.8 7-5.1 7-9.4V6l-7-3Z"/><path d="m9.3 11.8 2 2 3.5-3.6"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.2V12l3.1 2"/>',
  tag: '<path d="M11.7 3.5H19A1.5 1.5 0 0 1 20.5 5v7.3a2 2 0 0 1-.6 1.4l-6.6 6.6a2 2 0 0 1-2.8 0l-6-6a2 2 0 0 1 0-2.8l6.7-6.6a2 2 0 0 1 1.5-.4Z"/><circle cx="16" cy="8" r="1.3"/>',
  leaf: '<path d="M20 4c0 9.4-4.6 15-11 15a5 5 0 0 1-5-5C4 8.6 10.6 4 20 4Z"/><path d="M4.5 19.5C8 15 12 12 17 9.5"/>',
  guarantee: '<circle cx="12" cy="9.5" r="6.3"/><path d="m9.3 9.6 2 2 3.5-3.6"/><path d="m8 14.8-1 5.7 5-2.4 5 2.4-1-5.7"/>',
  calendar: '<rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 10h17M8 3.5v3M16 3.5v3"/>',
  check: '<path d="m4.8 12.4 4.8 4.8L19.2 6.8"/>',
  phone: '<path d="M6.3 3.5h3.1l1.5 4-2 1.5a12 12 0 0 0 6.1 6.1l1.5-2 4 1.5v3.1a2 2 0 0 1-2.1 2C11.1 19.4 4.6 12.9 4.3 5.6a2 2 0 0 1 2-2.1Z"/>',
  chevron: '<path d="m6.5 9.5 5.5 5.5 5.5-5.5"/>',
  arrow: '<path d="M4 12h15m-6-6 6 6-6 6"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="m6.5 6.5 11 11M17.5 6.5l-11 11"/>',
  wind: '<path d="M3 8h9.5a3 3 0 1 0-3-3"/><path d="M3 12.5h12.5a3 3 0 1 1-3 3"/><path d="M3 17h7"/>',
  starLine: '<path d="m12 3.4 2.7 5.4 6 .9-4.35 4.2 1.03 5.9L12 17.05 6.62 19.8l1.03-5.9L3.3 9.7l6-.9L12 3.4Z"/>',
  home: '<path d="m3.2 10.6 8.8-7.2 8.8 7.2"/><path d="M6 9.6V20.5h12V9.6"/><path d="M10.2 20.5v-5.2h3.6v5.2"/>',
  vacuum: '<path d="M7 20.5h10a2 2 0 0 0 2-2v-3a7 7 0 0 0-14 0v3a2 2 0 0 0 2 2Z"/><path d="M12 8.5v-4a2 2 0 0 1 2-2h5"/><circle cx="12" cy="16" r="2.2"/>',
  handshake: '<path d="M3.5 9.5 7 6h4l2 1.8L11 9.6a1.6 1.6 0 0 0 0 2.3l3.6 3.4"/><path d="M13 6h4l3.5 3.5"/><path d="M20.5 9.5v5l-2.5 2.5-3-2.8"/><path d="M3.5 9.5v5L6 17l3-2.8"/>',
  truck: '<path d="M2.5 7.4a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v9.1h-10Z"/><path d="M12.5 10.2h4.3l3.7 3.7v2.6h-8Z"/><circle cx="7" cy="18.4" r="1.9"/><circle cx="16.6" cy="18.4" r="1.9"/>',
} as const

const SOLID_ICONS = {
  star: '<path d="m12 3.4 2.7 5.4 6 .9-4.35 4.2 1.03 5.9L12 17.05 6.62 19.8l1.03-5.9L3.3 9.7l6-.9L12 3.4Z"/>',
  sparkle: '<path d="M12 3.2 13.8 9l5.8 1.8-5.8 1.8L12 18.4l-1.8-5.8L4.4 10.8 10.2 9 12 3.2Z"/><path d="M18.7 15.2l.75 2.35 2.35.75-2.35.75-.75 2.35-.75-2.35-2.35-.75 2.35-.75.75-2.35Z"/>',
  whatsapp:
    '<path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.47-2.39-1.48-.89-.79-1.48-1.76-1.66-2.06-.17-.3-.02-.46.13-.6.14-.14.3-.35.44-.53.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.87 1.22 3.07c.15.2 2.1 3.2 5.08 4.49.7.3 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.42-.08-.12-.27-.2-.57-.34M12.05 21.8h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.89 9.89-9.89 2.64 0 5.12 1.03 6.99 2.9a9.83 9.83 0 0 1 2.89 6.99c0 5.45-4.44 9.89-9.88 9.89m8.41-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.69 1.45h.005c6.55 0 11.89-5.34 11.89-11.89a11.82 11.82 0 0 0-3.48-8.41Z"/>',
} as const

export type IconName = keyof typeof STROKE_ICONS | keyof typeof SOLID_ICONS

const { name, size = 24, class: className = '', title, strokeWidth = 2, ...rest } = Astro.props as Props
const isSolid = name in SOLID_ICONS
const markup = isSolid
  ? SOLID_ICONS[name as keyof typeof SOLID_ICONS]
  : STROKE_ICONS[name as keyof typeof STROKE_ICONS]

if (!markup) throw new Error(`Icon "${name}" does not exist`)
---

<svg
  {...rest}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  class={className}
  fill={isSolid ? 'currentColor' : 'none'}
  stroke={isSolid ? 'none' : 'currentColor'}
  stroke-width={isSolid ? undefined : strokeWidth}
  stroke-linecap={isSolid ? undefined : 'round'}
  stroke-linejoin={isSolid ? undefined : 'round'}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
  focusable="false"
>
  <Fragment set:html={markup} />
</svg>
