---
// Every icon on the site comes from Phosphor (regular weight), one family and
// one stroke, read straight from @phosphor-icons/core at build time. Names are
// this site's own vocabulary so components never depend on Phosphor's names.
const FILES = import.meta.glob('/node_modules/@phosphor-icons/core/assets/regular/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>

const PHOSPHOR = {
  arrow: 'arrow-right',
  calendar: 'calendar-blank',
  check: 'check',
  chevron: 'caret-down',
  clock: 'clock',
  close: 'x',
  curtain: 'frame-corners',
  guarantee: 'seal-check',
  home: 'house-line',
  menu: 'list',
  phone: 'phone',
  renovation: 'paint-roller',
  shield: 'shield-check',
  snowflake: 'snowflake',
  sofa: 'couch',
  sparkle: 'sparkle',
  truck: 'truck',
  vacuum: 'broom',
  whatsapp: 'whatsapp-logo',
  wind: 'wind',
} as const

export type IconName = keyof typeof PHOSPHOR

interface Props {
  name: IconName
  size?: number
  class?: string
  title?: string
  /** Any extra attribute, such as a data hook, lands on the svg element. */
  [key: string]: unknown
}

const { name, size = 24, class: className = '', title, strokeWidth: _ignored, ...rest } =
  Astro.props as Props
const file = FILES[`/node_modules/@phosphor-icons/core/assets/regular/${PHOSPHOR[name]}.svg`]
if (!file) throw new Error(`Icon "${name}" does not exist`)

// Keep only the drawing; the outer svg is rebuilt below with our attributes.
const inner = file.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '')
---

<svg
  {...rest}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 256 256"
  width={size}
  height={size}
  class={className}
  fill="currentColor"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
  focusable="false"
>
  <Fragment set:html={inner} />
</svg>
