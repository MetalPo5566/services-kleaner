---
// Hand drawn icon set. Single style: 24x24 box, 2px stroke, round caps.
// Two icons are solid by nature (the WhatsApp glyph and the star).
interface Props {
  name: IconName
  size?: number
  class?: string
  title?: string
  /** Stroke weight in the 24 unit box. Larger pictograms read better lighter. */
  strokeWidth?: number
  /** Any extra attribute, such as a data hook, lands on the svg element. */
  [key: string]: unknown
}

const STROKE_ICONS = {
