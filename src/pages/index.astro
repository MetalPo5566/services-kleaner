---
import { Picture, getImage } from 'astro:assets'
import BaseLayout from '../layouts/BaseLayout.astro'
import Icon from '../components/Icon.astro'
import { GROUPS, SERVICES, BOOKING_URL, type Service } from '../data/services'
import { SERVICES_EN as copy } from '../data/copy/services.en'
import { SITE, ABSOLUTE_PAGES, whatsappLink } from '../data/site'
import { localBusinessSchema, itemListSchema } from '../lib/schema'
import heroPhoto from '../../assets/plates/hero-photo.png'

// The services hub, laid out like a super-app service menu: a photo-led hero,
// a launcher of the four groups, a sticky strip of group pills that follows the
// scroll, then each group in its own arrangement. One job: the visitor finds
// their service and taps straight into its booking link.
const PAGE = 'services-hub'

const [home, reno, specialist, moving] = GROUPS
// The bento leads with the tall sofa tile; the data keeps the brief's order.
const bySlug = (slug: string) => specialist.services.find((service) => service.slug === slug)!
const [sofa, aircond, curtain] = ['sofa-mattress', 'aircond-maintenance', 'curtain-carpet'].map(bySlug)
const mover = moving.services[0]

const schemas = [
  localBusinessSchema(`${SITE.url}${copy.meta.ogImage}`),
  itemListSchema({
    name: 'Kleaner cleaning services',
    url: ABSOLUTE_PAGES.services,
    items: SERVICES.map((service) => ({
      name: service.name,
      bookingUrl: service.bookingUrl,
      promise: service.line,
    })),
  }),
]

// The hero photo is the LCP element, so its exact candidates are preloaded.
const HERO_WIDTHS = [480, 720, 960, 1280, 1600]
const HERO_SIZES = '(min-width: 1024px) 56vw, calc(100vw - 32px)'
const heroAvif = await getImage({ src: heroPhoto, widths: HERO_WIDTHS, format: 'avif' })
const heroWebp = await getImage({ src: heroPhoto, widths: HERO_WIDTHS, format: 'webp' })

const wa = (message: string) => whatsappLink(message)
---

<BaseLayout
  title={copy.meta.title}
  description={copy.meta.description}
  path={copy.path}
  ogImage={copy.meta.ogImage}
  schemas={schemas}
  whatsappHref={wa(copy.hero.waMessage)}
  service={PAGE}
  htmlLang={copy.htmlLang}
  ogLocale={copy.ogLocale}
  stickyBar={false}
  showFloatingCtas={false}
  preloadImage={heroAvif.src}
  preloadImageSrcset={heroAvif.srcSet.attribute}
  preloadImageSizes={HERO_SIZES}
>
  {/* Hero. Phone: the photo leads, copy and actions under it. Desktop: copy
      left, photo right. Nothing is ever set on the photo. */}
  <section class="wrap pt-4 md:pt-8 lg:pt-12" aria-labelledby="hero-title" data-hero>
    <div class="grid gap-5 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-center lg:gap-14">
      <picture class="hero-photo block overflow-hidden rounded-tile lg:order-2">
        <source type="image/avif" srcset={heroAvif.srcSet.attribute} sizes={HERO_SIZES} />
        <source type="image/webp" srcset={heroWebp.srcSet.attribute} sizes={HERO_SIZES} />
        <img
          src={heroWebp.src}
          width={heroPhoto.width}
          height={heroPhoto.height}
          alt={copy.hero.photoAlt}
          class="h-full w-full object-cover"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>

      <div class="lg:order-1">
        <h1
          id="hero-title"
          class="text-[clamp(2.25rem,9.6vw,3.25rem)] leading-[1.04] tracking-[-0.03em] lg:text-[clamp(3.25rem,4.6vw,4.5rem)]"
        >
          {copy.hero.h1}
        </h1>
        <p class="mt-3 max-w-[34rem] text-[17px] leading-relaxed text-ink md:mt-4 md:text-[19px]">
          {copy.hero.sub}
        </p>
        <div class="mt-5 flex flex-wrap gap-3 md:mt-7">
          <a href={BOOKING_URL} class="btn btn-fill press" rel="noopener" data-cta="book" data-service="hero">
            {copy.hero.book}
          </a>
          <a
            href={wa(copy.hero.waMessage)}
            class="btn btn-line press"
            rel="noopener"
            data-cta="whatsapp"
            data-service="hero"
          >
            <Icon name="whatsapp" size={20} />
            {copy.hero.whatsApp}
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* Group launcher: the super-app shortcut row. Four tiles, one per group,
      each jumping to its group. Four across at every width. */}
  <nav class="wrap mt-7 md:mt-10" aria-label={copy.jump.label}>
    <ul class="grid grid-cols-4 gap-2 md:gap-4" role="list">
      {
        GROUPS.map((group) => (
          <li>
            <a href={`#${group.slug}`} class="launcher press" data-jump={group.slug}>
              <Picture
                src={group.photo}
                widths={[96, 160, 240]}
                sizes="(min-width: 768px) 120px, 64px"
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                alt=""
                class="launcher-photo"
                loading="lazy"
              />
              <Icon name={group.icon} size={28} class="mt-2 text-brand-ink md:mt-3" />
              <span class="launcher-label">{group.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  {/* The category strip. Sticks under the header and lights the group in view. */}
  <div class="pill-bar" data-pill-bar>
    <nav class="wrap" aria-label="Service groups">
      <ul class="pill-track" role="list">
        {
          GROUPS.map((group) => (
            <li>
              <a href={`#${group.slug}`} class="pill" data-pill={group.slug}>
                {group.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  {/* Home cleaning: a swipeable row of photo cards on phones; on wide screens
      the first card takes the larger column. */}
  <section id={home.slug} class="group-section wrap" aria-labelledby={`${home.slug}-title`} data-group>
    <h2 id={`${home.slug}-title`} class="group-title">{home.name}</h2>
    <ul class="home-track" role="list">
      {
        home.services.map((service) => (
          <li id={service.slug} class="anchor-target home-card" data-reveal>
            {service.aliases?.map((alias) => <span id={alias} class="anchor-alias" aria-hidden="true" />)}
            <Picture
              src={service.photo}
              widths={[360, 560, 800, 1100]}
              sizes="(min-width: 768px) 40vw, 80vw"
              formats={['avif', 'webp']}
                fallbackFormat="webp"
              alt={service.alt}
              class="aspect-[3/2] w-full object-cover"
            />
            <div class="flex flex-1 flex-col p-5">
              <h3 class="card-name">{service.name}</h3>
              <p class="card-line">{service.line}</p>
              <a
                href={service.bookingUrl}
                class="btn btn-fill btn-block press mt-auto"
                rel="noopener"
                data-cta="book"
                data-service={service.slug}
              >
                {service.cta}
              </a>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  {/* After renovation: two wide rows, photo, words, action. */}
  <section id={reno.slug} class="group-section wrap" aria-labelledby={`${reno.slug}-title`} data-group>
    <h2 id={`${reno.slug}-title`} class="group-title">{reno.name}</h2>
    <ul class="flex flex-col gap-3 md:gap-4" role="list">
      {
        reno.services.map((service) => (
          <li id={service.slug} class="anchor-target reno-row" data-reveal>
            <Picture
              src={service.photo}
              widths={[240, 400, 640]}
              sizes="(min-width: 768px) 300px, 34vw"
              formats={['avif', 'webp']}
                fallbackFormat="webp"
              alt={service.alt}
              class="reno-photo"
            />
            <div class="reno-body">
              <h3 class="card-name">{service.name}</h3>
              <p class="card-line">{service.line}</p>
            </div>
            <a
              href={service.bookingUrl}
              class="btn btn-fill press reno-cta"
              rel="noopener"
              data-cta="book"
              data-service={service.slug}
            >
              {service.cta}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {/* Specialist care: a bento of three. The tall sofa tile on the left, aircond
      and curtains stacked beside it. Phones: the tall tile, then two side by side. */}
  <section
    id={specialist.slug}
    class="group-section wrap"
    aria-labelledby={`${specialist.slug}-title`}
    data-group
  >
    <h2 id={`${specialist.slug}-title`} class="group-title">{specialist.name}</h2>
    <ul class="bento" role="list">
      {
        [sofa, aircond, curtain].map((service, index) => (
          <li
            id={service.slug}
            class:list={['anchor-target bento-tile', index === 0 ? 'bento-tall' : 'bento-small']}
            data-reveal
          >
            <Picture
              src={service.photo}
              widths={index === 0 ? [400, 700, 1000] : [300, 500, 800]}
              sizes={index === 0 ? '(min-width: 768px) 46vw, 100vw' : '(min-width: 768px) 22vw, 46vw'}
              formats={['avif', 'webp']}
                fallbackFormat="webp"
              alt={service.alt}
              class="bento-photo"
            />
            <div class="bento-body">
              <h3 class="card-name">{service.name}</h3>
              <p class="card-line">{service.line}</p>
              <a
                href={service.bookingUrl}
                class="btn btn-fill press mt-auto self-start"
                rel="noopener"
                data-cta="book"
                data-service={service.slug}
              >
                {service.cta}
              </a>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  {/* Moving: one wide banner, photo and a blue panel. Phones stack them. */}
  <section id={moving.slug} class="group-section wrap" aria-labelledby={`${moving.slug}-title`} data-group>
    <h2 id={`${moving.slug}-title`} class="group-title">{moving.name}</h2>
    <article id={mover.slug} class="anchor-target mover" data-reveal>
      {mover.aliases?.map((alias) => <span id={alias} class="anchor-alias" aria-hidden="true" />)}
      <Picture
        src={mover.photo}
        widths={[480, 800, 1200, 1600]}
        sizes="(min-width: 768px) 58vw, 100vw"
        formats={['avif', 'webp']}
                fallbackFormat="webp"
        alt={mover.alt}
        class="mover-photo"
      />
      <div class="mover-panel">
        <h3 class="text-[24px] font-extrabold leading-tight tracking-[-0.02em] text-[#fdfeff] md:text-[30px]">
          {mover.name}
        </h3>
        <p class="mt-2 text-[16px] leading-relaxed text-[#e3efff] md:text-[17px]">{mover.line}</p>
        <a
          href={mover.bookingUrl}
          class="btn btn-on-blue press mt-6 self-start"
          rel="noopener"
          data-cta="book"
          data-service={mover.slug}
        >
          {mover.cta}
        </a>
      </div>
    </article>
  </section>

  {/* Proof: the two facts the owner has confirmed, and nothing else. */}
  <section class="wrap mt-16 md:mt-24" aria-labelledby="proof-title">
    <div class="border-t border-line pt-10 md:pt-14">
      <h2 id="proof-title" class="text-[30px] leading-tight md:text-[44px]">{copy.proof.title}</h2>
      <div class="mt-8 grid gap-8 md:mt-10 md:grid-cols-2 md:gap-0">
        <div class="md:pr-12" data-reveal>
          <p class="text-[56px] font-extrabold leading-none tracking-[-0.04em] text-brand-ink md:text-[80px]">
            {copy.proof.hours.figure}
          </p>
          <p class="mt-3 max-w-[22rem] text-[17px] leading-relaxed text-ink md:text-[19px]">
            {copy.proof.hours.text}
          </p>
        </div>
        <div class="md:border-l md:border-line md:pl-12" data-reveal>
          <Icon name="guarantee" size={44} class="text-brand-ink" />
          <h3 class="mt-3 text-[24px] font-extrabold leading-tight md:text-[30px]">
            {copy.proof.guarantee.title}
          </h3>
          <p class="mt-2 max-w-[26rem] text-[17px] leading-relaxed text-ink md:text-[19px]">
            {copy.proof.guarantee.text}
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Close: WhatsApp, for the visitor who is still unsure. */}
  <section class="wrap mb-14 mt-16 md:mb-20 md:mt-24" aria-labelledby="close-title">
    <div class="close-band" data-reveal>
      <div>
        <h2 id="close-title" class="text-[28px] leading-tight md:text-[40px]">{copy.close.title}</h2>
        <p class="mt-3 max-w-[32rem] text-[17px] leading-relaxed text-ink md:text-[19px]">{copy.close.text}</p>
      </div>
      <a
        href={wa(copy.close.waMessage)}
        class="btn btn-fill press shrink-0"
        rel="noopener"
        data-cta="whatsapp"
        data-service="close"
      >
        <Icon name="whatsapp" size={20} />
        {copy.close.whatsApp}
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  // The pill strip follows the group in view: the group whose section crosses
  // the band just under the strip is the current one. Observer only, no
  // scroll listener; with JavaScript off the pills are plain anchor links.
  const strip = document.querySelector<HTMLElement>('.pill-track')
  const pills = new Map(
    Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-pill]')).map((pill) => [
      pill.dataset.pill,
      pill,
    ])
  )
  // Lights one pill, or none while the hero is in view, and slides the strip
  // so the lit pill shows. Only the strip scrolls, never the page.
  const setCurrent = (slug: string | undefined) => {
    pills.forEach((pill, key) => {
      if (key === slug) pill.setAttribute('aria-current', 'true')
      else pill.removeAttribute('aria-current')
    })
    if (!strip) return
    const lit = slug ? pills.get(slug) : undefined
    strip.scrollTo({ left: lit ? Math.max(0, lit.offsetLeft - strip.offsetLeft - 16) : 0 })
  }

  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return
          const target = entry.target as HTMLElement
          setCurrent(target.hasAttribute('data-hero') ? undefined : target.id)
        })
      },
      // A thin band 30 to 35 per cent down the viewport.
      { rootMargin: '-30% 0px -65% 0px' }
    )
    document
      .querySelectorAll<HTMLElement>('[data-group], [data-hero]')
      .forEach((section) => observer.observe(section))
  }
</script>

<style>
  .hero-photo {
    aspect-ratio: 2 / 1;
  }
  @media (min-width: 1024px) {
    .hero-photo {
      aspect-ratio: 4 / 3;
      max-height: calc(100dvh - 72px - 6rem);
      width: 100%;
    }
  }

  /* Buttons: full pills, one height, one weight. Filled is the action; the
     line button is the secondary. */
  :global(.btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 3rem;
    padding: 0 1.5rem;
    border-radius: 999px;
    font-size: 16px;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    transition:
      background-color 160ms var(--ease-out),
      color 160ms var(--ease-out),
      border-color 160ms var(--ease-out),
      transform 120ms var(--ease-out);
  }
  :global(.btn-fill) {
    background: var(--color-brand-dark);
    color: #fdfeff;
  }
  :global(.btn-line) {
    border: 2px solid var(--color-brand-dark);
    color: var(--color-brand-ink);
  }
  :global(.btn-on-blue) {
    background: #fdfeff;
    color: #0071d1;
  }
  :global(.btn-block) {
    width: 100%;
  }
  @media (hover: hover) and (pointer: fine) {
    :global(.btn-fill:hover) {
      background: var(--color-brand-hover);
    }
    :global(.btn-line:hover) {
      background: var(--color-tint);
    }
    :global(.btn-on-blue:hover) {
      background: #e3efff;
    }
  }

  .launcher {
    display: flex;
    height: 100%;
    flex-direction: column;
    align-items: center;
    padding: 0.75rem 0.25rem 0.85rem;
    border-radius: var(--radius-tile);
    background: var(--color-tint);
    text-align: center;
    text-decoration: none;
    transition: background-color 160ms var(--ease-out), transform 120ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .launcher:hover {
      background: var(--color-pill);
    }
  }
  .launcher :global(.launcher-photo) {
    width: 64px;
    height: 64px;
    border-radius: 999px;
    object-fit: cover;
  }
  .launcher-label {
    margin-top: 0.35rem;
    color: var(--color-navy);
    font-size: 13px;
    font-weight: 700;
    line-height: 1.2;
  }
  @media (min-width: 768px) {
    .launcher {
      padding: 1.25rem 0.75rem 1.4rem;
    }
    .launcher :global(.launcher-photo) {
      width: 120px;
      height: 120px;
    }
    .launcher-label {
      font-size: 18px;
    }
  }

  /* The strip sticks under the 59px (72px from 768px) header. */
  .pill-bar {
    position: sticky;
    top: 59px;
    z-index: 40;
    margin-top: 1.25rem;
    padding-block: 0.6rem;
    background: color-mix(in srgb, var(--color-page) 92%, transparent);
    backdrop-filter: blur(10px);
  }
  @media (min-width: 768px) {
    .pill-bar {
      top: 72px;
      margin-top: 2rem;
    }
  }
  .pill-track {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .pill-track::-webkit-scrollbar {
    display: none;
  }
  .pill-track > li {
    scroll-snap-align: start;
    flex-shrink: 0;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1.1rem;
    border-radius: 999px;
    background: var(--color-pill);
    color: var(--color-navy);
    font-size: 15px;
    font-weight: 700;
    white-space: nowrap;
    text-decoration: none;
    transition: background-color 160ms var(--ease-out), color 160ms var(--ease-out);
  }
  .pill[aria-current='true'] {
    background: var(--color-brand-dark);
    color: #fdfeff;
  }

  .group-section {
    margin-top: 2.5rem;
    scroll-margin-top: 120px;
  }
  @media (min-width: 768px) {
    .group-section {
      margin-top: 4.5rem;
      scroll-margin-top: 140px;
    }
  }
  .group-title {
    margin-bottom: 1rem;
    font-size: 28px;
  }
  @media (min-width: 768px) {
    .group-title {
      margin-bottom: 1.5rem;
      font-size: 40px;
    }
  }
  .anchor-target {
    scroll-margin-top: 130px;
  }
  @media (min-width: 768px) {
    .anchor-target {
      scroll-margin-top: 150px;
    }
  }
  .anchor-alias {
    position: absolute;
    top: 0;
    scroll-margin-top: inherit;
  }

  /* Astro wraps each photo in <picture>. Let the img be the grid or flex
     item itself, so the layout rules below size the photo, not the wrapper. */
  .home-card > :global(picture),
  .reno-row > :global(picture),
  .bento-tile > :global(picture),
  .mover > :global(picture) {
    display: contents;
  }

  .card-name {
    color: var(--color-navy);
    font-size: 20px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .card-line {
    margin-top: 0.4rem;
    margin-bottom: 1.1rem;
    color: var(--color-ink);
    font-size: 15.5px;
    line-height: 1.5;
  }

  /* Home cleaning. Phones: a horizontal snap row with the next card showing.
     768px and up: a three column grid, the first column wider. */
  .home-track {
    display: flex;
    gap: 0.75rem;
    margin-inline: -1rem;
    padding: 0.25rem 1rem 0.75rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 1rem;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .home-track::-webkit-scrollbar {
    display: none;
  }
  .home-card {
    position: relative;
    display: flex;
    flex: 0 0 80%;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-tile);
    background: var(--color-raised);
    scroll-snap-align: start;
  }
  @media (min-width: 768px) {
    .home-card :global(img) {
      height: 15rem;
      aspect-ratio: auto;
    }
    .home-track {
      display: grid;
      grid-template-columns: 1.35fr 1fr 1fr;
      gap: 1rem;
      margin-inline: 0;
      padding: 0;
      overflow: visible;
    }
  }

  /* After renovation. Rows: photo, words, action. Phones put the action under
     the words. */
  .reno-row {
    display: grid;
    grid-template-columns: 34% 1fr;
    grid-template-areas:
      'photo body'
      'photo cta';
    column-gap: 1rem;
    overflow: hidden;
    border-radius: var(--radius-tile);
    background: var(--color-tint);
  }
  .reno-row :global(.reno-photo) {
    grid-area: photo;
    width: 100%;
    height: 100%;
    min-height: 9rem;
    object-fit: cover;
  }
  .reno-body {
    grid-area: body;
    padding: 1rem 1rem 0 0;
  }
  .reno-cta {
    grid-area: cta;
    justify-self: start;
    margin: 0 1rem 1rem 0;
  }
  @media (min-width: 768px) {
    .reno-row {
      grid-template-columns: 300px 1fr auto;
      grid-template-areas: 'photo body cta';
      align-items: center;
      column-gap: 2rem;
    }
    .reno-row :global(.reno-photo) {
      min-height: 10.5rem;
    }
    .reno-body {
      padding: 1.5rem 0;
    }
    .reno-body .card-line {
      margin-bottom: 0;
    }
    .reno-cta {
      margin: 0 2rem 0 0;
    }
  }

  /* Specialist care. Phones: the tall tile full width, then the two small ones
     side by side. 768px and up: tall tile left across two rows, small tiles
     stacked on the right with their photo beside the words. */
  .bento {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .bento-tile {
    display: flex;
    flex-direction: column;
    overflow: hidden;
